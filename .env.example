# OpenAI-compatible Apertus endpoint (local llama-server, vLLM or Infomaniak)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=none
LLM_MODEL=apertus-8b
# apertus (real client, see docs/apertus_integration.md) or mock (fixtures, no network)
LLM_BACKEND=apertus
# OpenParlData API base URL
API_BASE=https://api.openparldata.ch
