# Apertus endpoint (OpenAI-compatible: local llama-server, vLLM or Infomaniak). Variable names as required by the HackApertus template.
LLM_NAME=apertus-8b
# Inside Docker, a server on the host is reachable as http://host.docker.internal:8080/v1
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=none
# apertus (real client, see docs/apertus_integration.md) or mock (fixtures, no network)
LLM_BACKEND=apertus
# OpenParlData API base URL
API_BASE=https://api.openparldata.ch
